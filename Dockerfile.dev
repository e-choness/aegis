FROM python:3.12-slim

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    build-essential \
    ca-certificates \
    gnupg \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Node.js 24 (LTS) via NodeSource (VitePress docs site; scripts/gen-terminal-demo.cjs)
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# uv — official binary from the release image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Package versions come from git tags (hatch-vcs). The repo is bind-mounted with
# a different owner, which git refuses to read unless it's marked safe.
RUN git config --system --add safe.directory '*'

# Python dependencies — including the spaCy model the PII pack loads — live in
# the uv venv (`uv sync --all-packages`), pinned by uv.lock.

WORKDIR /workspace

CMD ["bash"]
